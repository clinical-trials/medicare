# Preserve captured PubMed response bytes and suppress enormous raw-data diffs.
research/review_*/pubmed/raw/* -text -diff
research/review_*/pubmed/priority_records.json -diff
# CSV exports use RFC-style CRLF record endings; retain their bytes.
research/review_*/*.csv -text whitespace=cr-at-eol
research/review_*/pubmed/*.csv -text -diff
research/publication_*/search_extensions/raw/* -text -diff
# Matplotlib serializes SVG path coordinates with trailing spaces; preserve its bytes.
research/publication_*/figures/*.svg whitespace=-blank-at-eol
